rules_version = '2';

// =============================================================================
// Bro-POS Multi-Tenant Firestore Rules
// =============================================================================
// Strategi:
// - Subcollection per tenant: tenants/{tid}/products, transactions, attendance, ...
// - Otorisasi diutamakan via custom claims (tenantId, role, branchIds) → hemat
//   read karena tidak perlu memanggil get() ke Firestore tiap request.
// - Fallback aman: jika custom claims belum di-set, rules tetap menerima request
//   selama dokumen membership (tenants/{tid}/members/{uid}) ada & aktif.
//   Cocok untuk fase migrasi sebelum Cloud Function setActiveTenant di-deploy.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helpers =====
    function signedIn() {
      return request.auth != null;
    }

    function claimTenantId() {
      return signedIn() && 'tenantId' in request.auth.token
        ? request.auth.token.tenantId
        : null;
    }

    function claimRole() {
      return signedIn() && 'role' in request.auth.token
        ? request.auth.token.role
        : null;
    }

    function claimBranchIds() {
      return signedIn() && 'branchIds' in request.auth.token
        ? request.auth.token.branchIds
        : [];
    }

    function memberDoc(tid) {
      return /databases/$(database)/documents/tenants/$(tid)/members/$(request.auth.uid);
    }

    function memberExists(tid) {
      return signedIn() && exists(memberDoc(tid));
    }

    function memberData(tid) {
      return get(memberDoc(tid)).data;
    }

    function isMemberActive(tid) {
      return memberExists(tid) && memberData(tid).status == 'active';
    }

    function effectiveRole(tid) {
      return claimTenantId() == tid && claimRole() != null
        ? claimRole()
        : (memberExists(tid) ? memberData(tid).role : null);
    }

    function isInTenant(tid) {
      return claimTenantId() == tid || isMemberActive(tid);
    }

    function isOwnerRole(tid) {
      return effectiveRole(tid) == 'owner';
    }

    function isAdminRole(tid) {
      return effectiveRole(tid) in ['owner', 'admin'];
    }

    function isCashier(tid) {
      return effectiveRole(tid) == 'cashier';
    }

    function effectiveBranches(tid) {
      return claimTenantId() == tid && claimBranchIds().size() > 0
        ? claimBranchIds()
        : (memberExists(tid) ? memberData(tid).branchIds : []);
    }

    function hasBranchAccess(tid, b) {
      return effectiveBranches(tid).hasAny([b, '*']);
    }

    function subActive(tid) {
      return exists(/databases/$(database)/documents/subscriptions/$(tid))
        && get(/databases/$(database)/documents/subscriptions/$(tid)).data.status in ['trial', 'active'];
    }

    // ===== /users (global mapping) =====
    match /users/{uid} {
      allow read:   if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // ===== /plans (global, read-only) =====
    match /plans/{planId} {
      allow read:  if signedIn();
      allow write: if false;
    }

    // ===== /subscriptions =====
    match /subscriptions/{tid} {
      // Owner boleh baca status billingnya. Saat onboarding, owner juga membuat
      // dokumen subscription trial bersama dokumen tenant (lihat aturan create
      // di tenant). Update / cancel hanya boleh dari Cloud Function (Admin SDK).
      allow read:   if isInTenant(tid) && isOwnerRole(tid);
      allow create: if signedIn()
                    && request.resource.data.tenantId == tid
                    && request.resource.data.status in ['trial', 'active'];
      allow update, delete: if false;
    }

    // ===== /invites (untuk fitur invite member nanti) =====
    match /invites/{code} {
      allow read:   if signedIn()
                    && resource.data.email == request.auth.token.email;
      allow create: if signedIn() && isAdminRole(request.resource.data.tenantId);
      allow update, delete: if false;
    }

    // ===== /tenants/{tid} =====
    match /tenants/{tid} {
      allow read:   if isInTenant(tid);
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isInTenant(tid) && isOwnerRole(tid);
      allow delete: if false;

      // ----- members -----
      match /members/{uid} {
        // Pemilik tenant boleh menulis semua. Saat tenant baru dibuat, owner
        // juga membuat dokumen membership untuk dirinya sendiri (sebagai bagian
        // dari batch onboarding). Member boleh membaca daftar rekan satu
        // tenant, tetapi tidak bisa membaca lintas tenant.
        allow read:   if isInTenant(tid);
        allow create: if signedIn()
                      && (
                        // Owner mendaftarkan dirinya pertama kali.
                        (request.auth.uid == uid
                          && request.resource.data.role == 'owner'
                          && request.resource.data.uid == request.auth.uid)
                        // Atau admin/owner mengundang member lain.
                        || isAdminRole(tid)
                      );
        allow update: if isInTenant(tid) && isAdminRole(tid)
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['role', 'branchIds', 'status', 'name', 'updatedAt']);
        allow delete: if isInTenant(tid) && isOwnerRole(tid)
                      && uid != resource.data.uid;
      }

      // ----- branches -----
      match /branches/{bid} {
        allow read:   if isInTenant(tid);
        allow create: if isInTenant(tid)
                      && (
                        // Saat onboarding, owner sekaligus membuat cabang
                        // pertama dalam batch yang sama.
                        request.auth.uid == get(/databases/$(database)/documents/tenants/$(tid)).data.ownerUid
                        || isAdminRole(tid)
                      );
        allow update, delete: if isInTenant(tid) && isAdminRole(tid);
      }

      // ----- categories -----
      match /categories/{cid} {
        allow read:   if isInTenant(tid);
        allow create, update, delete: if isInTenant(tid) && isAdminRole(tid);
      }

      // ----- products -----
      match /products/{pid} {
        allow read:   if isInTenant(tid);
        allow create, delete: if isInTenant(tid) && isAdminRole(tid);
        // Admin: boleh update penuh. Cashier: hanya boleh menyentuh field stok.
        allow update: if isInTenant(tid) && (
          isAdminRole(tid) ||
          (isCashier(tid)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['stockByBranch', 'totalStock', 'updatedAt']))
        );
      }

      // ----- transactions -----
      match /transactions/{txid} {
        allow read:   if isInTenant(tid)
                      && (isAdminRole(tid) || resource.data.userId == request.auth.uid);

        allow create: if isInTenant(tid)
                      && request.resource.data.userId == request.auth.uid
                      && hasBranchAccess(tid, request.resource.data.branchId)
                      && request.resource.data.totalPrice ==
                         (request.resource.data.paidAmount - request.resource.data.changeAmount)
                      && request.resource.data.status == 'completed'
                      && request.resource.data.paymentMethod in ['cash', 'qris', 'debit']
                      && subActive(tid);

        allow update: if isInTenant(tid) && isAdminRole(tid)
                      && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['paymentMethod', 'paidAmount', 'changeAmount', 'status', 'updatedAt'])
                      && request.resource.data.paymentMethod in ['cash', 'qris', 'debit']
                      && request.resource.data.paidAmount >= resource.data.totalPrice
                      && request.resource.data.changeAmount ==
                         request.resource.data.paidAmount - resource.data.totalPrice;

        allow delete: if false;
      }

      // ----- attendance -----
      match /attendance/{aid} {
        allow read:   if isInTenant(tid);
        allow create: if isInTenant(tid)
                      && request.resource.data.userId == request.auth.uid
                      && request.resource.data.status == 'active'
                      && hasBranchAccess(tid, request.resource.data.branchId);
        allow update: if isInTenant(tid) && (
          isAdminRole(tid) ||
          (resource.data.userId == request.auth.uid
            && resource.data.status == 'active'
            && request.resource.data.status == 'closed'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'endedAt', 'closingCash']))
        );
        allow delete: if false;
      }

      // ----- reports_daily (ditulis Cloud Function aggregator) -----
      match /reports_daily/{key} {
        allow read:  if isInTenant(tid) && isAdminRole(tid);
        allow write: if false;
      }

      // ----- audit_logs (write-only via Admin SDK) -----
      match /audit_logs/{lid} {
        allow read:  if isInTenant(tid) && isOwnerRole(tid);
        allow write: if false;
      }

      // Default deny untuk subcollection lain di bawah tenant.
      match /{document=**} {
        allow read, write: if false;
      }
    }
  }
}
