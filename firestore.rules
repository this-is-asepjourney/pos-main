rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isCashier() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "cashier";
    }

    function isStaff() {
      return isAdmin() || isCashier();
    }
    
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && request.resource.data.role in ["admin", "cashier"];
      allow update: if (
        isOwner(userId)
        && request.resource.data.role == resource.data.role
      ) || isAdmin();
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stock", "updatedAt"])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
      );
    }

    match /attendance/{attendanceId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == "active"
        && request.resource.data.role in ["admin", "cashier"];
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "endedAt"])
        && resource.data.status == "active"
        && request.resource.data.status == "closed"
      );
      allow delete: if false;
    }

    match /transactions/{transactionId} {
      // Admin & cashier (staff) boleh membaca semua transaksi.
      // Cashier butuh akses ini untuk halaman Pengembalian (query collection-level).
      allow read: if isStaff();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if (
        isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["paymentMethod", "paidAmount", "changeAmount", "updatedAt"])
        && request.resource.data.paymentMethod in ["cash", "qris", "debit"]
        && request.resource.data.paidAmount >= resource.data.totalPrice
        && request.resource.data.changeAmount == request.resource.data.paidAmount - resource.data.totalPrice
      ) || (
        isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "actualReturnDate",
          "returnedAt",
          "returnChecklist",
          "lateDays",
          "lateFeeAmount",
          "totalPrice",
          "paidAmount",
          "changeAmount",
          "updatedAt"
        ])
        && resource.data.actualReturnDate == null
        && request.resource.data.status == "returned"
        && request.resource.data.actualReturnDate is string
        && request.resource.data.lateDays is int
        && request.resource.data.lateDays >= 0
        && request.resource.data.lateFeeAmount >= 0
        && (
          (("baseTotalPrice" in resource.data) && request.resource.data.totalPrice >= resource.data.baseTotalPrice)
          || (!("baseTotalPrice" in resource.data) && request.resource.data.totalPrice >= resource.data.totalPrice)
        )
        && request.resource.data.paidAmount >= resource.data.paidAmount
        && request.resource.data.changeAmount >= 0
        && (
          (request.resource.data.paidAmount >= request.resource.data.totalPrice
            && request.resource.data.changeAmount == request.resource.data.paidAmount - request.resource.data.totalPrice)
          || (request.resource.data.paidAmount < request.resource.data.totalPrice
            && request.resource.data.changeAmount == 0)
        )
      );
      allow delete: if false;
    }
  }
}